# Pinned versions for artifacts that have no stable "latest" URL.
# Bump these when a download starts failing; 11-verify.sh reports 404s.

UBUNTU_CODENAME=noble          # Ubuntu 24.04 LTS
TARGET_OS_VERSION=24.04

# Go: https://go.dev/dl/
GO_VERSION=1.27.4

# Yandex Music .deb has no "latest" alias, only versioned S3 objects.
YANDEX_MUSIC_VERSION=5.126.1

# Windows VM sizing (16 GB host RAM)
VM_NAME=Windows11
VM_CPUS=4
VM_RAM_MB=8192
VM_DISK_GB=120
VM_ISO_URL=""                  # fill in, or place the ISO in vm/iso/
