{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/mikhail/.codex/hooks/workflow.py check",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 120,
            "statusMessage": "Waiting for your answer in the island (Coucou)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/mikhail/.codex/hooks/workflow.py format",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/mikhail/.local/share/coucou/bin/coucou-hook' --agent codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
